<immediate-query xmlns="http://tail-f.com/ns/tailf-rest-query">
  <foreach>/devices/device</foreach>
  <select>
    <expression>name</expression>
    <result-type>string</result-type>
    <label>name</label>
  </select>
  <select>
    <expression>state/admin-state</expression>
    <result-type>string</result-type>
    <label>admin-state</label>
  </select>
  <select>
    <expression>esnet-common:role</expression>
    <result-type>string</result-type>
    <label>role</label>
  </select>
  <select>
    <expression>platform/name</expression>
    <result-type>string</result-type>
    <label>platform-name</label>
  </select>
  <select>
    <expression>platform/version</expression>
    <result-type>string</result-type>
    <label>platform-version</label>
  </select>
  <select>
    <expression>platform/model</expression>
    <result-type>string</result-type>
    <label>platform-model</label>
  </select>
  <select>
    <expression>device-type/cli/ned-id</expression>
    <result-type>string</result-type>
    <label>cli-ned-id</label>
  </select>
  <select>
    <expression>device-type/netconf/ned-id</expression>
    <result-type>string</result-type>
    <label>netconf-ned-id</label>
  </select>
  <sort-by>name</sort-by>
  <timeout>600</timeout>
</immediate-query>
